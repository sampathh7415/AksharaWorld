{
  "name": "autopilot-store",
  "version": "2.0.0",
  "description": "BizOps real-time business platform + legacy PixelForge store",
  "private": true,
  "scripts": {
    "legacy:store": "node src/server.js",
    "backend:dev": "npm run start:dev --prefix backend",
    "backend:build": "npm run build --prefix backend",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --prefix backend",
    "db:seed": "npm run prisma:seed --prefix backend"
  },
  "engines": {
    "node": ">=20"
  }
}
