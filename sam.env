# ============================================================
# sam.env.example — Sam local agent configuration
# Copy to sam.env and fill in your values.
# NEVER commit sam.env to git.
# ============================================================

# ── Ollama ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# qwen3 is downloading (5.2 GB) → switch to this once done:
# SAM_MODEL=qwen3
SAM_MODEL=qwen3.6:latest              # ACTIVE right now (qwen3 downloading)
SAM_MODEL_FAST=llama3:latest
SAM_MODEL_CREATIVE=gemma4:latest
# GPU layers: 0 = CPU-only, 99 = max GPU offload (auto-detected)
OLLAMA_NUM_GPU=auto

# ── Telegram ─────────────────────────────────────────────────
# Real token from @Akshara23bot (already in .env.local)
TELEGRAM_BOT_TOKEN=8588723914:AAF8dKryuAKXvR8ubx9gYE2jPuwmuwN01f0
TELEGRAM_OWNER_CHAT_ID=7125107324
TELEGRAM_ALLOWED_IDS=7125107324

# ── Sam Daemon ───────────────────────────────────────────────
SAM_PORT=8765
SAM_HOST=0.0.0.0
SAM_DATA_DIR=./sam-data             # SQLite, logs, embeddings stored here
SAM_LOG_LEVEL=INFO

# ── Memory ───────────────────────────────────────────────────
SAM_MEMORY_DB=./sam-data/sam.db
SAM_SHORT_TERM_LIMIT=50             # keep last N conversation turns
SAM_MEMORY_PRUNE_DAYS=30            # prune long-term memories older than N days
SAM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Security ─────────────────────────────────────────────────
SAM_SESSION_TIMEOUT_MINUTES=10
SAM_UNLOCK_CODE=1234                # code to unlock after session timeout
# Comma-separated allowed base paths for file/terminal tools
SAM_ALLOWED_PATHS=C:/Users,G:/My Drive/Antigravity,C:/tmp
# Commands that always require explicit override
SAM_BLOCKED_COMMANDS=rm -rf,dd,mkfs,format,del /f /s /q

# ── Approval Flow ─────────────────────────────────────────────
SAM_APPROVAL_TIMEOUT_SECONDS=120    # 2 minutes; timeout → auto-REJECT (safe)

# ── Voice ────────────────────────────────────────────────────
# Get free key at https://picovoice.ai/
PICOVOICE_ACCESS_KEY=your_picovoice_key_here
SAM_WAKE_WORD=hey sam               # custom keyword or built-in
# Path to piper binary (download from https://github.com/rhasspy/piper/releases)
PIPER_BINARY=./sam-data/voice/piper
PIPER_VOICE_MODEL=./sam-data/voice/en_US-lessac-medium.onnx
# Path to whisper.cpp binary (download from https://github.com/ggerganov/whisper.cpp)
WHISPER_BINARY=./sam-data/voice/whisper-cli
WHISPER_MODEL=./sam-data/voice/ggml-base.en.bin
SAM_VOICE_ENABLED=false             # set true after voice binaries installed

# ── LangSmith (optional tracing) ─────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls_your_key_here
LANGCHAIN_PROJECT=sam-local

# ── Email (send_email tool — uses Gmail, free) ───────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sampathh7415@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
# Get Gmail App Password: myaccount.google.com → Security → App Passwords
SMTP_FROM=Sam <sampathh7415@gmail.com>
# false = draft mode only (recommended); true = can actually send
SAM_EMAIL_CAN_SEND=false

# ── Dashboard ────────────────────────────────────────────────
SAM_DASHBOARD_SECRET=change_this_secret_key
