# ==============================================================================
# .env.example — React Native App Environment Variables Template
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the same directory.
# 2. Replace placeholder values with your actual service credentials.
# 3. DO NOT commit the actual '.env' file to your Git repository.
# ==============================================================================

# ── SUPABASE CONFIGURATION (Database & Auth) ──────────────────────────────────
# Public credentials required for initializing the Supabase client SDK.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ── SENTRY CONFIGURATION (Error & Crash Tracking) ─────────────────────────────
# Unique Sentry DSN to report unhandled JavaScript and native exceptions.
SENTRY_DSN=https://your-public-key@o000000.ingest.sentry.io/0000000
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=sntryu_your_private_auth_token_here_for_sourcemaps

# ── EXPO EAS NATIVE BUILDS ────────────────────────────────────────────────────
# Private environment flags needed if you inject credentials during local builds.
EXPO_TOKEN=expo_your_auth_token_here
EXPO_PROJECT_ID=your-expo-project-uuid-here
