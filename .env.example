# 🐙 AKSHARA WORLD — Environment Variables Template
# Copy this file to .env.local and populate with your credentials.

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Google reCAPTCHA Enterprise
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Google Analytics GA4
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_measurement_id_here

# Google Search Console verification
GOOGLE_SITE_VERIFICATION=your_gsc_verification_code_here

# Google AdSense
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=your_adsense_pub_id_here

# Google Merchant Center
NEXT_PUBLIC_MERCHANT_ID=your_merchant_id_here

# Blogger
NEXT_PUBLIC_BLOGGER_ID=your_blogger_id_here

# YouTube
NEXT_PUBLIC_YOUTUBE_HANDLE=your_youtube_handle_here
# YOUTUBE_API_KEY=your_youtube_api_key_here

# Gmail Newsletter
NEXT_PUBLIC_NEWSLETTER_EMAIL=your_newsletter_email_here
APPS_SCRIPT_WEBHOOK_URL=your_google_sheets_webhook_url_here

# Google Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_ID=your_firebase_messaging_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id_here

# Sam Brain CEO Worker URL
SAM_BRAIN_URL=your_cloudflare_worker_url_here
NEXT_PUBLIC_SAM_URL=your_cloudflare_worker_url_here

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_pub_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# 🤖 OpenHuman Local AI Agent Integration
OPENHUMAN_API_URL=http://localhost:3000/api/v1/openhuman/sync-hook
OPENHUMAN_DATABASE_PATH=./.code-review-graph/openhuman-memory.json
OPENHUMAN_SYNC_INTERVAL_MIN=20

# ☁️ Local AWS Cloud Emulation via Floci
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# 💳 Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=akshara_secret_2026
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# 📲 Telegram Bot (for alerts & notifications)
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 📧 Brevo (Email Marketing / Transactional Email)
BREVO_API_KEY=your_brevo_api_key_here

# 📊 Google Sheets (Metrics & Transactions Log)
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# 📈 Google Analytics 4 (Automation Reporting)
GA4_PROPERTY_ID=your_ga4_property_id_here
GA4_ACCESS_TOKEN=your_ga4_service_account_access_token_here

# 📲 WhatsApp Number
NEXT_PUBLIC_WHATSAPP_NUMBER=your_whatsapp_number_here

# 🤖 Ollama — Local AI Provider (replaces Gemini in development)
# Start with: ollama serve && ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
